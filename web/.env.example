# URL the Next.js SERVER uses to reach Django for the early-access form.
# Local default (Django on 8300):
DJANGO_API_URL=http://127.0.0.1:8300

# URL the BROWSER uses to call the workspace API (public, inlined at build time).
# Local development falls back to http://127.0.0.1:8300 when this is unset.
# On Vercel set it to the public HTTPS URL of the Django service, for example:
# NEXT_PUBLIC_WORKSPACE_API_URL=https://api.example.com
NEXT_PUBLIC_WORKSPACE_API_URL=http://127.0.0.1:8300

# Never add provider keys here: Gemini and Hosted keys belong to Django only.
