# Copy this file to .env and replace the placeholder values before running.
# Never commit your real .env file to git.

# Password used on first run to create the default "admin" account
DOCUTRUST_ADMIN_PASSWORD=change-me-admin-pass

# Secret key used to generate daily 6-digit HMAC attendance codes
DOCUTRUST_ATTENDANCE_SECRET=change-me-attendance-secret

# Password used by seed.py for demo employee accounts (alice, bob)
DOCUTRUST_DEMO_PASSWORD=change-me-demo-pass

# ---- Demo workspace (Django) ---------------------------------------------
# Public demo: there is no sign-in. Use synthetic documents only.
# Provider keys live here, on the Django server only. Never put them in web/.

# Default provider shown in the chat: local, gemini or hosted
# (blank = first available, preferring local)
DOCUTRUST_AI_PROVIDER=

# Local: Ollama on the Django host (needs `ollama serve` and a pulled model)
DOCUTRUST_OLLAMA_BASE_URL=http://127.0.0.1:11434
# Optional preferred model; installed Ollama models are listed automatically
DOCUTRUST_OLLAMA_MODEL=

# Gemini: leave the key blank until you have one
DOCUTRUST_GEMINI_API_KEY=
DOCUTRUST_GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite

# Hosted: any OpenAI-compatible API (base URL ending in /v1 or the full /chat/completions URL)
DOCUTRUST_HOSTED_BASE_URL=
DOCUTRUST_HOSTED_API_KEY=
DOCUTRUST_HOSTED_MODELS=
DOCUTRUST_HOSTED_LABEL=Hosted

# Browser origins allowed to call /api/workspace/ (comma separated, exact origins, no *)
DOCUTRUST_CORS_ALLOWED_ORIGINS=http://127.0.0.1:3100,http://localhost:3100
# Hostnames Django should answer to in production (comma separated)
DJANGO_ALLOWED_HOSTS=
DJANGO_SECRET_KEY=change-me-before-deploying
DJANGO_DEBUG=1

# Storage: put both on a persistent disk when deploying
DOCUTRUST_DJANGO_DB=
DOCUTRUST_MEDIA_ROOT=
# Optional limits (defaults: config.toml uploads.max_file_mb, 500 documents)
DOCUTRUST_MAX_UPLOAD_BYTES=
DOCUTRUST_MAX_DOCUMENTS=
